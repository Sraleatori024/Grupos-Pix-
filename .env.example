# ========================================================
# PLATAFORMA DE GESTÃO DE GRUPOS, PAGAMENTOS PIX E SORTEIOS
# Arquivo de Variáveis de Ambiente de Exemplo (.env.example)
# ========================================================

# Servidor & Host
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ========================================================
# CONFORMIDADE LEGAL & REGULAÇÃO BRASILEIRA (LEI 5.768/71)
# Valores: PENDING_REVIEW | AUTHORIZED | DISABLED
# ========================================================
PROMOTION_LEGAL_STATUS=PENDING_REVIEW
LEGAL_PROCESS_NUMBER="SPA/MF nº 01.000000/2026-00"

# ========================================================
# SYNCPAYMENTS (GATEWAY PIX OFICIAL)
# ========================================================
# Credencial pública (já configurada no ambiente da Vercel)
SYNCPAY_API_PUBLIC=
# URL base da API da SyncPayments (Padrão: https://api.d5pay.com)
SYNCPAY_BASE_URL=https://api.d5pay.com
# Credenciais privadas de parceiro (armazenadas com segurança no backend)
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
# Chave secreta compartilhada para validação de assinatura do webhook
SYNCPAY_WEBHOOK_SECRET=
# URL pública do webhook registrada na SyncPayments (ex: https://meusite.com/api/webhooks/syncpay)
SYNCPAY_WEBHOOK_URL=

# ========================================================
# GATEWAY PIX (Mercado Pago, EFI/Gerencianet, Asaas, etc.)
# ========================================================
PIX_GATEWAY_PROVIDER=mock_and_live_compatible
PIX_KEY=financeiro@plataformagrupos.com.br
PIX_MERCHANT_NAME="Plataforma Grupos Pix BR"
PIX_MERCHANT_CITY="SAO PAULO"
PIX_WEBHOOK_SECRET=sec_pix_live_change_me_in_production
PIX_ENTRY_PRICE_CENTS=100

# ========================================================
# FIREBASE FIRESTORE & AUTH (Quando ativado)
# ========================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_ID=

# AI Studio Injection
GEMINI_API_KEY=
